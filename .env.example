# Where the SQLite database and uploaded files live (default: ./data)
DATA_DIR=./data
# Public URL of the site when hosted (required in production for form security)
ORIGIN=http://localhost:3000
PORT=3000

# --- Hosting on Vercel (no persistent disk) ---
# Create a free Turso database (Vercel Marketplace > Turso) and set these two.
# Leave them unset locally and the app uses a SQLite file in DATA_DIR instead.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=
# (ORIGIN is only needed when running the Node server yourself, not on Vercel.)
